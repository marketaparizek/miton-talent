# Miton talent chat - backend environment variables.
# Copy to .env and fill in the secrets. NEVER commit .env to the repo.

# Required. The dedicated Miton key (not Alister's).
ANTHROPIC_API_KEY=sk-ant-...

# Transitional: while set, every submission is also written to Notion. The database
# is the system of record; submissions.jsonl is written only if the database write fails.
NOTION_TOKEN=
NOTION_DATABASE_ID=1ba6065a-c67d-4ba6-97f5-1a6c9662d137

# CORS: sites whose pages call /chat and /submit directly. The Miton domains (code default).
# For local development use: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=https://www.miton.cz,https://miton.cz
# Who may show the chat page (/) in an iframe. Defaults to ALLOWED_ORIGINS. Add the
# Alister origin whose /miton hub embeds the chat: https://alisterai.com in production,
# http://localhost:3000 locally. Keep dev/staging sites out of production's list; in
# production non-https origins are ignored. Every other route refuses to be framed.
# FRAME_ANCESTORS=https://www.miton.cz,https://miton.cz,https://alisterai.com

# Email / CV delivery (Resend over SMTP). Without these the CV email is skipped.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=onboarding@resend.dev
MAIL_TO=marketa.parizek@miton.cz

# Optional. The Claude model.
MODEL=claude-sonnet-4-6

# Automatic candidate scoring after submit. Off by default; set to 1 to enable once
# the evaluation prompt (SCORE_SYSTEM in app.py) is finalised. SCORE_MODEL defaults
# to MODEL; point it at a cheaper/faster model if you like.
SCORING_ENABLED=0
SCORE_MODEL=

# Optional. From this user message on, the model is told to wrap up and show the form.
SOFT_CLOSE_TURNS=5

# Optional. Rate limits per visitor network (IPv4 address or IPv6 /64), counted in the
# database so every worker shares them (count per window in seconds).
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW=600
SUBMIT_RATE_LIMIT=5
SUBMIT_RATE_WINDOW=600
# Optional. Model calls per UTC day for the whole service (chat + scoring). The cost cap.
LLM_DAILY_BUDGET=1000
# Optional. Chats never submitted are deleted after this many days.
CHAT_RETENTION_DAYS=7

# Sign-in to the back office (/admin, /diag) comes from Alister: it mints a one-minute
# token signed with this secret (talent/auth.py). Same value in Alister's .env as
# TALENT_HANDOFF_SECRET; at least 32 characters. Local dev: point ALISTER_BASE_URL at
# the local Alister web app.
TALENT_HANDOFF_SECRET=
ALISTER_BASE_URL=http://localhost:3000
# Signs the back-office session cookie. REQUIRED in production (APP_BASE_URL on https):
# the app refuses to start without it, or with the same value as TALENT_HANDOFF_SECRET.
# At least 32 characters: openssl rand -hex 32. Locally it may stay empty.
SESSION_SECRET=
# Optional. Back-office session length in hours (default 12).
# SESSION_MAX_AGE_HOURS=12
