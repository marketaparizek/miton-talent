# Miton talent chat - backend environment variables.
# Copy to .env and fill in the secrets. NEVER commit .env to the repo.

# Required. The dedicated Miton key (not Alister's).
ANTHROPIC_API_KEY=sk-ant-...

# Required for saving submissions to Notion. Without it, submissions go to
# submissions.jsonl only (which does NOT persist on Render/Railway).
NOTION_TOKEN=
NOTION_DATABASE_ID=1ba6065a-c67d-4ba6-97f5-1a6c9662d137

# CORS. In production keep the Miton domains (this is also the code default).
# For local development use: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=https://www.miton.cz,https://miton.cz

# Email / CV delivery (Resend over SMTP). Without these the CV email is skipped.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=onboarding@resend.dev
MAIL_TO=marketa.parizek@miton.cz

# Optional. The Claude model.
MODEL=claude-sonnet-4-6

# Optional. Per-IP rate limits (count per window in seconds).
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW=600
SUBMIT_RATE_LIMIT=5
SUBMIT_RATE_WINDOW=600
