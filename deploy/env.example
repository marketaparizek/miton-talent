# /root/live/miton-talent/.env  (chmod 600; never committed)

# --- model ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-4-6

# --- database (own database on the shared Hetzner Postgres; setup_server.sh creates it) ---
DATABASE_URL=postgresql+psycopg://miton_talent:CHANGE_ME@127.0.0.1:5432/miton_talent

# --- public origin + who may embed the chat ---
# Hostname nginx serves; switch to talent.miton.cz once the DNS record exists
DOMAIN=talent.miton.cz
APP_BASE_URL=https://talent.miton.cz
# Also the Alister origins: the /miton hub in Alister embeds the chat widget
# (frame-ancestors is built from this list), so without them the embed is blank.
ALLOWED_ORIGINS=https://www.miton.cz,https://miton.cz,https://preview.miton.cz,https://alisterai.com,https://dev.alisterai.com

# --- sign-in: the handoff from Alister (talent/auth.py) ---
# The ONLY way into the back office (/admin, /diag). Alister mints one-minute
# tokens signed with this secret; set the SAME value as TALENT_HANDOFF_SECRET in
# Alister's .env and nowhere else. At least 32 characters: openssl rand -hex 32
TALENT_HANDOFF_SECRET=CHANGE_ME_TOO
# Where an unauthenticated browser is sent to sign in (Alister's /talent page)
ALISTER_BASE_URL=https://alisterai.com
# Optional: back-office session length (cookie), default 30 days
# SESSION_MAX_AGE_DAYS=30

# --- CV e-mail to the recruiter (Resend over HTTPS; SMTP_* works too) ---
RESEND_API_KEY=re_...
# Resend sandbox sender (delivers only to the Resend account owner's inbox). Switch to an
# address on a domain verified in THIS Resend account once miton.cz is verified there.
MAIL_FROM=onboarding@resend.dev
MAIL_TO=marketa.parizek@miton.cz

# --- automatic scoring after submit (off until the prompt is final) ---
SCORING_ENABLED=0
# SCORE_MODEL=claude-sonnet-4-6

# --- transitional: also write every submission to Notion. Delete after the import. ---
# NOTION_TOKEN=ntn_...
# NOTION_DATABASE_ID=1ba6065a-c67d-4ba6-97f5-1a6c9662d137

# --- backups (deploy/backup_db.sh) ---
BACKUP_DIR=/root/db_backups/miton_talent
RETENTION_DAYS=30
# OFFSITE_CMD="rclone copy $BACKUP_DIR gdrive:miton-talent-backups"
